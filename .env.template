# Required
GROQ_API_KEY=
GEMINI_API_KEY=

# Per-tenant API keys. Generate with: python scripts/generate_keys.py
# Format: ARBITER_KEY_<TENANT_ID_UPPER>=arb_<tenant>_<secret>
# ARBITER_KEY_TENANT_A=
# ARBITER_KEY_TENANT_B=
# ARBITER_KEY_TENANT_TEST=

# Optional (tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Better Stack source token for persistent logs.
# Sign up at https://betterstack.com/logs -> create a source -> copy the token.
LOGTAIL_SOURCE_TOKEN=

# Optional: Redis URL for persistent rate limits and budget tracking.
# Render Key Value (Redis), Upstash free tier, or Railway Redis.
# Leave blank to use in-memory state (resets on restart).
# If set, the app will refuse to start if Redis is unreachable.
REDIS_URL=
